# ============================================================
# SMART ROUTE — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ======================== DOMAIN & PLATFORM ========================
WEB_APP_URL=https://smartroutebooking.com
API_BASE_URL=https://api.smartroutebooking.com

# ======================== SERVER ========================
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# ======================== DATABASE ========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartroute
DB_USER=smartroute_user
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://smartroute_user:your_db_password_here@localhost:5432/smartroute
DB_POOL_MAX=10
DB_SSL=false
# Set REQUIRE_DURABLE_STORAGE=true to strictly forbid in-memory fallback (automatically enforced in NODE_ENV=production)
REQUIRE_DURABLE_STORAGE=false

# ======================== SUPER ADMIN BOOTSTRAP (CLI ONLY) ========================
# Required only when running: npm run admin:bootstrap
SUPER_ADMIN_EMAIL=admin@smartroutebooking.com
SUPER_ADMIN_PASSWORD=your_strong_admin_password_min_8_chars
SUPER_ADMIN_MOBILE=9000000001
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ======================== AUTHENTICATION ========================
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_SECRET=your_otp_secret_here
OTP_EXPIRY_MINUTES=5

# ======================== BCRYPT ========================
BCRYPT_SALT_ROUNDS=12

# ======================== RATE LIMITING ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ======================== MAP PROVIDER ========================
# Supported: leaflet (free, default), mapbox, google
MAP_PROVIDER=leaflet
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_MAP_PROVIDER=leaflet
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ======================== PAYMENT GATEWAY ========================
# Supported: razorpay, stripe
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ======================== EMAIL ========================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@smartroute.in

# ======================== SMS ========================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ======================== AI PROVIDER ========================
# Supported: openai, gemini
AI_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ======================== VOICE / CALL PROVIDER ========================
# Supported: twilio, exotel
VOICE_PROVIDER=twilio
VOICE_TWILIO_ACCOUNT_SID=your_twilio_sid_here
VOICE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VOICE_TWILIO_PHONE_NUMBER=+1234567890
VOICE_STATUS_CALLBACK_URL=https://api.smartroutebooking.com/api/voice/status
VOICE_INBOUND_MESSAGE_URL=https://api.smartroutebooking.com/api/voice/inbound/message

# ======================== PUSH NOTIFICATIONS ========================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@smartroute.in

# ======================== FILE STORAGE ========================
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
AWS_S3_BUCKET=your_bucket_here
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here

# ======================== LOGGING ========================
LOG_LEVEL=info
LOG_FILE=./logs/smartroute.log
